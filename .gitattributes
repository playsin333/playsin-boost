* text=auto eol=lf
# Preserve the hybrid launcher bytes for cmd.exe and package checksums.
*.bat -text
*.txt text eol=lf
*.zip binary

# GitHub Download ZIP contains the user package, not development material.
/.gitattributes export-ignore
/.gitignore export-ignore
/docs export-ignore
/tests export-ignore
/tools export-ignore
/releases export-ignore
/boost-release.json export-ignore
/.github export-ignore
/assets export-ignore
/media export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
*.png binary
*.mp4 binary
*.svg text eol=lf
